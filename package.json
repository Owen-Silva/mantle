{
  "name": "mantle",
  "version": "0.1.1",
  "private": true,
  "description": "A shell layer over Windows: own bar, launcher and desktop, Windows kept underneath.",
  "license": "GPL-3.0-only",
  "author": "Atlas Studio",
  "repository": {
    "type": "git",
    "url": "https://github.com/Owen-Silva/mantle.git"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "live": "electron . --live",
    "quit": "electron . --quit",
    "restore": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/restore-windows.ps1",
    "autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-autostart.ps1 -Run",
    "autostart:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-autostart.ps1 -Uninstall",
    "test": "electron . --test --profile-name=dev",
    "shots": "electron . --test --profile-name=dev --screenshot=shots",
    "check": "node tools/check.js",
    "kill:test": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/kill-test.ps1 -Match dev",
    "build:sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File sidecar/build.ps1",
    "test:pinned": "node lib/pinned.test.js",
    "test:sidecar": "node sidecar/test-sidecar.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "koffi": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^44.3.0"
  }
}
